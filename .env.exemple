# Configuration de la ligne de commande `npm run brd`.
# Copier ce fichier en `.env` (jamais versionné) et le remplir.
# L'application de bureau garde ses propres réglages ; elle lit seulement
# les deux clés ci-dessous si aucune clé n'est enregistrée dans ses réglages.

# Mode hybride : clé OpenRouter (Jev et résumés passent par elle).
OPENROUTER_API_KEY=

# Facultatif : clé TypeSafe, pour appeler Jev en direct plutôt que par OpenRouter.
TYPESAFE_API_KEY=
# openrouter (par défaut) ou typesafe
BRD_JEV_ACCES=openrouter
BRD_JEV_MODELE=jev-latest

# Modèle cloud des résumés en mode hybride.
BRD_OPENROUTER_MODELE_RESUME=qwen/qwen3.8-flash
# 1 pour n'accepter que des fournisseurs à rétention nulle (ZDR).
BRD_OPENROUTER_ZDR=0

# Masquage des données personnelles avant tout envoi hors de la machine (1 ou 0).
BRD_MASQUAGE=1

# Mode local : serveur Ollama et modèles installés (`ollama pull qwen3.5:4b`).
OLLAMA_URL=http://127.0.0.1:11434
BRD_OLLAMA_MODELE_DECISION=qwen3.5:4b
BRD_OLLAMA_MODELE_RESUME=qwen3.5:4b

# Options facultatives, désactivées par défaut (1 pour activer). Elles passent par l'Ollama ci-dessus.
# Recherche sémantique : `ollama pull embeddinggemma` (ou nomic-embed-text-v2-moe).
BRD_SEMANTIQUE=0
BRD_OLLAMA_MODELE_PLONGEMENT=embeddinggemma
# Lecture des PDF scannés : `ollama pull minicpm-v4.6:1b`.
BRD_OCR=0
BRD_OLLAMA_MODELE_OCR=minicpm-v4.6:1b
BRD_OCR_PAGES_MAX=10
